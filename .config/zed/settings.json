{
  "ssh_connections": [
    {
      "host": "work-mac-mini",
      "args": [],
      "projects": [
        {
          "paths": [
            "/Users/chungwei/.dotfiles"
          ]
        },
        {
          "paths": [
            "/Users/chungwei/Developer/agent-hub/./"
          ]
        }
      ]
    }
  ],
  "cli_default_open_behavior": "new_window",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access",
      },
      "type": "registry",
    },
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": false
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
      "effort": "medium",
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "group_by": "none",
    "tree_view": true,
    "dock": "left",
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "all",
  },
  "buffer_font_features": {
    "liga": false,
    "calt": false,
  },
  "edit_predictions": {
    "mode": "subtle",
  },
  "file_types": {
    "JSON": ["site.webmanifest"],
    "JSONC": [".oxlintrc.json"],
  },
  "auto_install_extensions": {
    "tsgo": true,
    "oxc": true,
    "emmet": true,
    "rainbow-csv": true,
    "codebook": true,
  },
  "languages": {
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "oxlint",
        "oxfmt",
        "!eslint",
        "...",
      ],
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "oxlint",
        "oxfmt",
        "!eslint",
        "...",
      ],
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "oxlint",
        "oxfmt",
        "!eslint",
        "...",
      ],
    },
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
      ],
    },
  },
}
